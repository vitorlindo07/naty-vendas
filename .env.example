# Copie para .env e ajuste. Nunca envie o .env para o GitHub.
ENV=production
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_EXPIRE_MINUTES=480

# Primeiro acesso ao painel (usado só quando o banco está vazio). Troque a senha no primeiro login.
ADMIN_NAME=Naty
ADMIN_EMAIL=admin@natyalves.com.br
ADMIN_PASSWORD=Trocar@123

# Banco: SQLite por padrão. Para PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/banco
# DATABASE_URL=
# Pasta do banco e das fotos (padrão: backend/data; no Docker: /data)
# DATA_DIR=
MAX_UPLOAD_MB=5
